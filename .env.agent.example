# Shop-Books DOCUMENT STORAGE AGENT — runs on the owner's Windows desktop (example only).
#
# Copy to .env.agent in the repository root (gitignored) and start the agent with
#   $env:SHOP_BOOKS_ENV_FILE = ".env.agent"; npm --prefix server run storage-agent
# Cloudflare Tunnel then publishes http://127.0.0.1:8787 as e.g. https://storage.example.com,
# which is the API's DOCUMENT_STORAGE_AGENT_URL. See docs/hosted-deployment.md.

# Private folder for the bill photos/PDFs (absolute path, outside any web or sync folder).
# Back it up together with the database.
AGENT_STORAGE_DIR=D:\ShopBooksDocuments

# Exactly the same value as the API's DOCUMENT_STORAGE_AGENT_SECRET (Render dashboard).
# Generate once:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGENT_SECRET=

# Listen on this PC only; cloudflared connects locally. Never forward this port on your router.
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
