# Shop-Books BACKEND — STAGING on your Windows PC behind a Cloudflare Tunnel (example only).
#
# Copy to .env.staging in the repository root (gitignored) and start the backend with
#   $env:SHOP_BOOKS_ENV_FILE = ".env.staging"
# These are PRIVATE server settings: never copy any of them into Vercel or a VITE_ variable.
# See docs/staging-deployment.md.

NODE_ENV=development

# Listen on this PC only. cloudflared connects locally; nothing on the LAN or internet can reach
# the port directly. Do NOT forward port 3000 or 5432 on your router.
HOST=127.0.0.1
PORT=3000

# A SEPARATE staging database with test data only (never your real records), migrated to the
# latest version: create it, then run the migrations with this file selected.
DATABASE_URL=postgresql://shop_books_app:CHANGE_ME@localhost:5432/shop_books_staging

# EXACT web origins allowed to call the API (no wildcards, no trailing slash):
# the Vercel production domain of the project, plus local development if you also use it.
FRONTEND_URL=https://your-project.vercel.app,http://localhost:5173

# Different random value from development (at least 32 characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The Vercel site and the tunnel are different sites, so the session cookie must be
# "SameSite=None; Secure" to be sent with the site's cross-site API requests. The tunnel is HTTPS.
COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

# Exactly one trusted proxy (cloudflared) sits in front, so the real client address is used for
# the per-IP sign-in limit instead of 127.0.0.1 for everyone.
TRUST_PROXY=true

LOG_LEVEL=info
SHOP_NAME=Shop-Books (staging)

# Bill photos/PDFs of the STAGING database (absolute path, outside any web folder).
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DIR=D:\ShopBooksStaging\documents

# No e-mail is sent from staging.
EMAIL_PROVIDER=none
