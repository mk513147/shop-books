{
  "name": "shop-books-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:status": "tsx src/database/cli.ts status",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:status:built": "node dist/database/cli.js status",
    "db:migrate:built": "node dist/database/cli.js migrate",
    "owner:create": "tsx src/cli/createOwner.ts",
    "owner:create:built": "node dist/cli/createOwner.js",
    "owner:reset-password": "tsx src/cli/resetOwnerPassword.ts",
    "owner:reset-password:built": "node dist/cli/resetOwnerPassword.js",
    "suppliers:backfill-report": "tsx src/cli/supplierBackfillReport.ts",
    "suppliers:backfill-report:built": "node dist/cli/supplierBackfillReport.js",
    "documents:reconcile": "tsx src/cli/documentsReconcile.ts",
    "documents:reconcile:built": "node dist/cli/documentsReconcile.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cors": "^2.8.6",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
