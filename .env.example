# Shop-Books server configuration (variable names and SAFE PLACEHOLDERS only).
#
# Copy this file to the environment-specific file you need. Each copy is gitignored:
#   .env.development   used when NODE_ENV is unset or "development"
#   .env.test          used when NODE_ENV=test (automated tests)
#   .env.production    optional; production hosts should inject real environment variables
# Variables already present in the process environment always win over file values.
# Never commit real values. Never reuse one environment's database for another.

# development | test | production  (normally set by the tooling, not in the file)
NODE_ENV=development

# Port the API listens on.
PORT=3000

# PostgreSQL connection string.
# Safety rule enforced at startup: when NODE_ENV=test the database name MUST end in "_test";
# in every other environment it must NOT end in "_test".
#   development: postgresql://shop_books_app:CHANGE_ME@localhost:5432/shop_books_dev
#   test:        postgresql://shop_books_app:CHANGE_ME@localhost:5432/shop_books_test
DATABASE_URL=postgresql://shop_books_app:CHANGE_ME@localhost:5432/shop_books_dev

# Browser origin(s) allowed to call the API (comma-separated). Production requires https.
FRONTEND_URL=http://localhost:5173

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Maximum PostgreSQL connections held by the API.
DATABASE_POOL_MAX=10

# Set to true only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=false

# Optional. Reported by GET /api/v1/health when set (e.g. a release tag or commit).
APP_VERSION=

# --- Authentication -------------------------------------------------------------
# REQUIRED. Server-side secret used to derive per-session CSRF tokens. At least 32 random
# characters; use a different value per environment. Changing it invalidates CSRF tokens
# (users simply reload the page). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# SameSite attribute of the session cookie: lax (default) | strict | none.
# Keep "lax" when the web app and API share a site. "none" is only accepted in production
# (Secure cookies) and only makes sense for a cross-site API, which also needs CORS review.
SESSION_COOKIE_SAMESITE=lax

# --- Bill photographs / documents (Stage 3B) -------------------------------------
# Storage adapter. Only "local" exists today (files on the API server's disk).
DOCUMENT_STORAGE_DRIVER=local
# Absolute path of a PRIVATE directory outside any web root (never served statically).
# Optional in development/test (defaults: <repo>/storage/documents and <repo>/storage/documents-test,
# both gitignored). REQUIRED in production. Back it up together with the database.
#   Windows example: D:\ShopBooksData\documents
# DOCUMENT_STORAGE_DIR=

# --- Reports and monthly e-mail (Stages 4–5) --------------------------------------
# Name printed on reports, Excel files and e-mails.
SHOP_NAME=Shop-Books
# E-mail adapter: none | outbox.
#   none   = not configured: monthly e-mails are recorded as FAILED ("not configured"); nothing is sent.
#            Default in production.
#   outbox = development only: writes each e-mail to EMAIL_OUTBOX_DIR and records it as SIMULATED.
#            Default in development/test; refused in production.
# A real provider (SMTP relay or HTTP API) still has to be implemented; see docs/architecture.md.
# EMAIL_PROVIDER=
# Sender, e.g. "Shop-Books <reports@your-domain.example>" (default "<SHOP_NAME> <reports@localhost>").
# EMAIL_FROM=
# Absolute folder for the outbox adapter (default <repo>/storage/email-outbox, gitignored).
# EMAIL_OUTBOX_DIR=
# Run the monthly report scheduler in this process (default true; false in tests).
# REPORT_SCHEDULER_ENABLED=true
# How often the scheduler checks for due work, in seconds (15–3600, default 60).
# REPORT_SCHEDULER_INTERVAL_SECONDS=60

# --- Future stages (placeholders only; NOT read or required yet) ----------------
# Private object storage adapter (provider not yet selected). When added it will use e.g.
# DOCUMENT_STORAGE_DRIVER=s3 plus:
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Credentials of the future real e-mail provider adapter (not read yet), e.g.
# EMAIL_PROVIDER_API_KEY=
# SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASSWORD=
